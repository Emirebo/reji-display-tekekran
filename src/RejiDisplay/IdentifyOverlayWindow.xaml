<Window x:Class="RejiDisplay.IdentifyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identify Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">
    <Border Background="#D00B132B" CornerRadius="16" BorderBrush="#00B4D8" BorderThickness="4" Margin="40" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TxtNumber" Text="DISPLAY 1" FontSize="56" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="TxtDetails" Text="1920 x 1080 (Primary / Operator)" FontSize="22" Foreground="#90E0EF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtStatus" Text="CENTER / Extended Desktop" FontSize="16" Foreground="#FFD166" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
