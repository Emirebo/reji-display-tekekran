<Window x:Class="RejiDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RejiDisplay v0.3 — Single Master Output &amp; Live Presentation Composer"
        Height="850" Width="1200"
        MinHeight="750" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="CardBackground" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>

        <!-- Button Styles -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TakeBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="24,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34D399"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F87171"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBBF24"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Display Role Assignment Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Unified Master Layout Live Preview -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Action Bar (TAKE & Master Controls) -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Region Content Cards (LEFT & RIGHT) -->
            <RowDefinition Height="*"/>
            <!-- 5: Footer Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="RejiDisplay v0.3 — Single Master Output &amp; Live Presentation Composer" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Logical Master Canvas: 4301 × 1720 px | GPU Presentation Capture &amp; Live Composition Engine" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnToggleSimulation" Content="🧪 SİMÜLASYON MODU" Style="{StaticResource SecondaryBtnStyle}" Click="BtnToggleSimulation_Click" Margin="0,0,8,0"/>
                <Button Content="🔍 EKRANLARI NUMARALANDIR" Style="{StaticResource SecondaryBtnStyle}" Click="BtnIdentify_Click" Margin="0,0,8,0"/>
                <Button Content="🛑 MASTER ÇIKIŞI DURDUR" Style="{StaticResource DangerBtnStyle}" Click="BtnStopMaster_Click"/>
            </StackPanel>
        </Grid>

        <!-- 1. DISPLAY ROLE ASSIGNMENT TOOLBAR -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Display 1 Role -->
                    <ColumnDefinition Width="1.1*"/>
                    <!-- Display 2 Role -->
                    <ColumnDefinition Width="1.4*"/>
                    <!-- Display 3 Role -->
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- DISPLAY 1: CONTROL UI -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="DISPLAY 1 — KONTROL EKRANI:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="TxtControlDisplayLabel" Text="Birincil Ekran (Operatör Paneli)" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- DISPLAY 2: PRESENTATION SOURCE -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="DISPLAY 2 — SUNUM EKRANI (PowerPoint Canlı Yakalama):" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                    <ComboBox x:Name="CmbPresentationSource" Style="{StaticResource ComboBoxStyle}" Margin="0,4,0,0" SelectionChanged="CmbPresentationSource_SelectionChanged"/>
                </StackPanel>

                <!-- DISPLAY 3: MASTER LED OUTPUT -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DISPLAY 3 — MASTER LED ÇIKIŞI (NovaStar VX2000 Pro):" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                    <ComboBox x:Name="CmbMasterOutput" Style="{StaticResource ComboBoxStyle}" Margin="0,4,0,0" SelectionChanged="CmbMasterOutput_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. UNIFIED MASTER LAYOUT LIVE PREVIEW (4301 x 1720 Aspect Ratio Container) -->
        <Border Grid.Row="2" Background="#020617" BorderBrush="#1E293B" BorderThickness="2" CornerRadius="10" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️ BİRLEŞİK LED MASTER DÜZEN ÖNİZLEMESİ (4301 × 1720)" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock x:Name="TxtMasterStatusBadge" Text="[ DRAFT PREVIEW ]" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="TxtCaptureFps" Text="FPS: -- | MODE: IDLE" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Grid>

                <!-- Proportional 3-Region Canvas Container -->
                <Grid Grid.Row="1" Background="#0B0F19">
                    <Grid.ColumnDefinitions>
                        <!-- Left: 860 width (approx 20%) -->
                        <ColumnDefinition Width="860*"/>
                        <ColumnDefinition Width="4"/>
                        <!-- Middle: 2581 width (approx 60%) -->
                        <ColumnDefinition Width="2581*"/>
                        <ColumnDefinition Width="4"/>
                        <!-- Right: 860 width (approx 20%) -->
                        <ColumnDefinition Width="860*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PREVIEW REGION -->
                    <Border Grid.Column="0" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ImgLeftPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLeftDraftPrompt" Text="LEFT (860x1720)" FontSize="11" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#1E293B" CornerRadius="2" Padding="4,2" Margin="4">
                                <TextBlock Text="LEFT LED" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- MIDDLE PREVIEW REGION (LIVE SUNUM STREAM) -->
                    <Border Grid.Column="2" Background="#0F172A" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ImgMiddlePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtMiddleDraftPrompt" Text="DISPLAY 2 CANLI SUNUM YAKALAMA (2581x1376)" FontSize="11" Foreground="#047857" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#064E3B" CornerRadius="2" Padding="4,2" Margin="4">
                                <TextBlock Text="MIDDLE (LIVE)" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT PREVIEW REGION -->
                    <Border Grid.Column="4" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ImgRightPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtRightDraftPrompt" Text="RIGHT (860x1720)" FontSize="11" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1E293B" CornerRadius="2" Padding="4,2" Margin="4">
                                <TextBlock Text="RIGHT LED" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Calibration Controls -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Middle Ekran Dikey Kalibrasyonu (Y-Offset):" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider Grid.Column="1" x:Name="SliderMiddleYOffset" Minimum="0" Maximum="344" Value="172" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderMiddleYOffset_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="TxtMiddleYOffset" Text="172 px (Ortalanmış)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. ACTION BAR (TAKE & MASTER CONTROLS) -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PROMINENT TAKE BUTTON -->
            <Button Grid.Column="0" x:Name="BtnTake" Content="🎬 TAKE / STAGE TO LIVE (MASTER YAYINA AL)" Style="{StaticResource TakeBtnStyle}" Click="BtnTake_Click"/>
            <Button Grid.Column="2" x:Name="BtnMasterBlackout" Content="⚫ MASTER SİYAH EKRAN" Style="{StaticResource WarningBtnStyle}" Click="BtnMasterBlackout_Click"/>
            <Button Grid.Column="4" x:Name="BtnStartMaster" Content="▶ MASTER ÇIKIŞI BAŞLAT" Style="{StaticResource PrimaryBtnStyle}" Click="BtnStartMaster_Click"/>
        </Grid>

        <!-- 4. REGION CONTENT CARDS (LEFT & RIGHT DRAFT EDITORS) -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT REGION CARD -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="LEFT LED GÖRSELİ (860×1720)" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Grid>

                    <!-- Drop Zone -->
                    <Border Grid.Row="1" x:Name="DropZoneLeft" Background="#0F172A" BorderBrush="#334155" BorderThickness="2" CornerRadius="6"
                            AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZoneLeft_Drop" Padding="10">
                        <Grid>
                            <StackPanel x:Name="PanelLeftDropPrompt" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🖼️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Görseli Buraya Sürükleyin" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="PNG, JPG, WEBP" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <Image x:Name="ImgLeftCardPreview" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" MaxHeight="120"/>
                        </Grid>
                    </Border>

                    <!-- Scale Controls -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <TextBlock x:Name="TxtLeftMediaPath" Text="Seçili: (Henüz yok)" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RadioLeftFit" Content="Fit" GroupName="LeftScale" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioLeftScale_Checked"/>
                            <RadioButton x:Name="RadioLeftFill" Content="Fill" GroupName="LeftScale" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioLeftScale_Checked"/>
                            <RadioButton x:Name="RadioLeftStretch" Content="Stretch" GroupName="LeftScale" Foreground="#F8FAFC" Checked="RadioLeftScale_Checked"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Blackout Button -->
                    <Button Grid.Row="3" x:Name="BtnLeftBlack" Content="⚫ LEFT Blackout" Style="{StaticResource SecondaryBtnStyle}" Click="BtnLeftBlack_Click"/>
                </Grid>
            </Border>

            <!-- RIGHT REGION CARD -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="RIGHT LED GÖRSELİ (860×1720)" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Grid>

                    <!-- Drop Zone -->
                    <Border Grid.Row="1" x:Name="DropZoneRight" Background="#0F172A" BorderBrush="#334155" BorderThickness="2" CornerRadius="6"
                            AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZoneRight_Drop" Padding="10">
                        <Grid>
                            <StackPanel x:Name="PanelRightDropPrompt" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🖼️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Görseli Buraya Sürükleyin" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="PNG, JPG, WEBP" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <Image x:Name="ImgRightCardPreview" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" MaxHeight="120"/>
                        </Grid>
                    </Border>

                    <!-- Scale Controls -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <TextBlock x:Name="TxtRightMediaPath" Text="Seçili: (Henüz yok)" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RadioRightFit" Content="Fit" GroupName="RightScale" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioRightScale_Checked"/>
                            <RadioButton x:Name="RadioRightFill" Content="Fill" GroupName="RightScale" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioRightScale_Checked"/>
                            <RadioButton x:Name="RadioRightStretch" Content="Stretch" GroupName="RightScale" Foreground="#F8FAFC" Checked="RadioRightScale_Checked"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Blackout Button -->
                    <Button Grid.Row="3" x:Name="BtnRightBlack" Content="⚫ RIGHT Blackout" Style="{StaticResource SecondaryBtnStyle}" Click="BtnRightBlack_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. FOOTER STATUS BAR -->
        <Border Grid.Row="5" Background="{StaticResource CardBackground}" CornerRadius="6" Padding="10,6">
            <Grid>
                <TextBlock x:Name="TxtGlobalStatus" Text="Sistem Hazır. Display 2 (Sunum) ve Display 3 (Master Output) seçimlerini yapın." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="RejiDisplay v0.3 Experimental" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
            </Grid>
        </Border>
    </Grid>
</Window>
