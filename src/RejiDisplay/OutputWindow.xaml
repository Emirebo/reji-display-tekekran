<Window x:Class="RejiDisplay.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LED Output"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        WindowStartupLocation="Manual">
    <Canvas x:Name="MainCanvas" Background="Black" ClipToBounds="True">
        <!-- Calibrated Signal Viewport Container -->
        <Canvas x:Name="ViewportCanvas" Background="Black" ClipToBounds="True">
            <Image x:Name="MediaImage" Stretch="Fill" Visibility="Collapsed"/>
            <MediaElement x:Name="MediaVideo"
                          Stretch="Fill"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Visibility="Collapsed"
                          MediaEnded="MediaVideo_MediaEnded"
                          MediaOpened="MediaVideo_MediaOpened"
                          MediaFailed="MediaVideo_MediaFailed"/>
        </Canvas>

        <!-- Live Blackout Overlay -->
        <Grid x:Name="BlackoutOverlay"
              Background="Black"
              Visibility="Collapsed"
              Canvas.Left="0" Canvas.Top="0"/>
    </Canvas>
</Window>


